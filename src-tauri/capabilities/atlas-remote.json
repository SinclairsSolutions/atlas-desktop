{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "atlas-remote",
  "description": "Die Live-Seite von Atlas: Mitteilungen, Dock-Zahl, Drucken, fremde Links im Standardbrowser, Downloads in den Download- bzw. Export-Ordner, Bestätigung von Eingangs-Uploads, Touch-ID-Prüfung und Fenster ziehen — sonst kein Datei- oder Systemzugriff.",
  "windows": [
    "main",
    "neben-*"
  ],
  "remote": {
    "urls": [
      "https://sinclair-atlas.com",
      "https://www.sinclair-atlas.com"
    ]
  },
  "permissions": [
    "allow-mitteilung",
    "allow-mitteilungen-erlauben",
    "allow-kennzahl",
    "allow-extern-oeffnen",
    "allow-drucken",
    "allow-datei-speichern",
    "allow-dateien-erledigt",
    "allow-touch-id-pruefen",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-geraet-geheimnis"
  ]
}