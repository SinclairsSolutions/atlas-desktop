<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Wird von Tauri mit der erzeugten Info.plist zusammengeführt. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>de</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>de</string>
    <string>en</string>
  </array>
  <key>NSMicrophoneUsageDescription</key>
  <string>Atlas nimmt Meetings und Sprachnachrichten auf, wenn du das startest.</string>
  <key>NSCameraUsageDescription</key>
  <string>Atlas nutzt die Kamera nur, wenn du ein Foto oder einen Scan aufnimmst.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Atlas speichert heruntergeladene Dateien im Download-Ordner.</string>
  <!-- Belege aufs Dock-Symbol ziehen: die App nimmt PDFs und Bilder an
       (Rang „Alternate“ — sie wird nie Standard-Programm für diese Dateien). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Beleg</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.adobe.pdf</string>
        <string>public.image</string>
        <string>public.xml</string>
        <string>com.apple.mail.email</string>
      </array>
    </dict>
  </array>
  <!-- App-Symbol für macOS 26: Assets.car (aus icons/AppIcon.icon, gebaut in
       der CI). CFBundleIconFile (icon.icns, von Tauri gesetzt) bleibt als
       Rückfall, etwa für lokale Builds ohne Assets.car. -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>NSHumanReadableCopyright</key>
  <string>© Sinclairs Solutions</string>
</dict>
</plist>
