<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- File-Provider-Erweiterung „Ablage im Finder“. Version und Build setzt
     scripts/finder-ablage-bauen.sh aus package.json. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>de</string>
  <key>CFBundleDisplayName</key>
  <string>Atlas Ablage</string>
  <key>CFBundleExecutable</key>
  <string>AtlasAblage</string>
  <key>CFBundleIdentifier</key>
  <string>com.sinclairs-solutions.atlas.ablage</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>AtlasAblage</string>
  <key>CFBundlePackageType</key>
  <string>XPC!</string>
  <key>CFBundleShortVersionString</key>
  <string>0.0.0</string>
  <key>CFBundleVersion</key>
  <string>0.0.0</string>
  <key>CFBundleSupportedPlatforms</key>
  <array><string>MacOSX</string></array>
  <key>LSMinimumSystemVersion</key>
  <string>12.0</string>
  <key>NSHumanReadableCopyright</key>
  <string>© Sinclairs Solutions</string>
  <key>NSExtension</key>
  <dict>
    <key>NSExtensionPointIdentifier</key>
    <string>com.apple.fileprovider-nonui</string>
    <key>NSExtensionPrincipalClass</key>
    <string>AtlasAblageErweiterung</string>
    <key>NSExtensionFileProviderDocumentGroup</key>
    <string>KJ63M9QZUG.com.sinclairs-solutions.atlas</string>
    <key>NSExtensionFileProviderSupportsEnumeration</key>
    <true/>
    <!-- „Nur Universe-Team“ neben dem Namen (Kategorie Sharing = Text, kein eigenes Symbol nötig). -->
    <key>NSFileProviderDecorations</key>
    <array>
      <dict>
        <key>Identifier</key>
        <string>com.sinclairs-solutions.atlas.ablage.nur-universe</string>
        <key>Category</key>
        <string>Sharing</string>
        <key>Label</key>
        <string>Nur Universe-Team</string>
      </dict>
    </array>
    <!-- Kontextmenü: Sichtbarkeit umstellen, nur für Universe-Interne mit Schreibrecht
         (userInfo.kannSicht, gesetzt in Eintrag.swift); Atlas prüft es zusätzlich. -->
    <key>NSExtensionFileProviderActions</key>
    <array>
      <dict>
        <key>NSExtensionFileProviderActionIdentifier</key>
        <string>com.sinclairs-solutions.atlas.ablage.fuer-workspace</string>
        <key>NSExtensionFileProviderActionName</key>
        <string>Für Workspace freigeben</string>
        <key>NSExtensionFileProviderActionActivationRule</key>
        <string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.kannSicht == 1 AND $fileproviderItem.userInfo.sicht == "universe" ).@count &gt; 0</string>
      </dict>
      <dict>
        <key>NSExtensionFileProviderActionIdentifier</key>
        <string>com.sinclairs-solutions.atlas.ablage.nur-universe</string>
        <key>NSExtensionFileProviderActionName</key>
        <string>Nur fürs Universe-Team</string>
        <key>NSExtensionFileProviderActionActivationRule</key>
        <string>SUBQUERY ( fileproviderItems, $fileproviderItem, $fileproviderItem.userInfo.kannSicht == 1 AND $fileproviderItem.userInfo.sicht == "workspace" ).@count &gt; 0</string>
      </dict>
    </array>
  </dict>
</dict>
</plist>
