<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rechte der File-Provider-Erweiterung: Sandbox (Pflicht für Erweiterungen),
     Netzwerk nur ausgehend (zu Atlas), App-Gruppe für die Übergabe des
     Gerätezugangs von der App. Ohne Bereitstellungsprofil: App-Gruppe im
     macOS-Stil mit Team-ID (KJ63M9QZUG.…), siehe README. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>KJ63M9QZUG.com.sinclairs-solutions.atlas</string>
  </array>
</dict>
</plist>
